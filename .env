# General
NEXT_PUBLIC_APP_NAME="LLM-SE"
NEXT_PUBLIC_HOST="localhost"
LMSTUDIO_HOST="host.docker.internal"

# Models
MODEL_EMBEDDING=nomic-embed-text:v1.5
MODEL_MA=mradermacher/Grok-3-reasoning-gemma3-12B-distilled-HF-GGUF/Grok-3-reasoning-gemma3-12B-distilled-HF.Q4_K_S.gguf
MODEL_KPI_ANALYST=lmstudio-community/gemma-3-4B-it-qat-GGUF/gemma-3-4B-it-QAT-Q4_0.gguf
MODEL_SYSML_EXPERT=mradermacher/Grok-3-reasoning-gemma3-12B-distilled-HF-GGUF/Grok-3-reasoning-gemma3-12B-distilled-HF.Q4_K_S.gguf

# Knowledge Layer - Relational
POSTGRES_USER=root
POSTGRES_PASSWORD=fu27soma
POSTGRES_DB=postgres

# Knowledge Layer - Object
MINIO_ROOT_USER=root
MINIO_ROOT_PASSWORD=fu27soma
MINIO_BROWSER=true
MINIO_DEFAULT_BUCKET=data-object

# Knowledge Layer - Vector
QDRANT_DEFAULT_COLLECTION=data-vector
QDRANT_SYSML_COLLECTION=data-sysml

# LLM Layer - Models
MODELS_THINKING=deepseek-r1:14b, gemma3:12b, qwen3:8b, llama3.1:8b, mistral:7b, magistral:24b
EMBEDDING_DIMENSION=768
EMBEDDING_CHUNK_SIZE=512
EMBEDDING_CHUNK_OVERLAP=64
MODEL_TIMEOUT=600

# Initialization
INIT_DATA_FOLDER=data
INIT_DATA_FOLDER_SQL=sql
INIT_DATA_FOLDER_RAW=raw
INIT_KNOWLEDGE_SCHEMA_FILE=knowledge.sql
INIT_MANAGEMENT_SCHEMA_FILE=management.sql

# Seed
SEED_DATA_FOLDER=data
SEED_DATA_FOLDER_SQL=sql
SEED_DATA_FOLDER_RAW=raw